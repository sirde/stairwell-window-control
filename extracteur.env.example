# extracteur.env — SECRETS and per-machine values ONLY. (gitignored)
#
# Copy to extracteur.env and fill in:
#     cp extracteur.env.example extracteur.env && chmod 600 extracteur.env
#
# Everything else (weather thresholds, radar, ntfy enable/server, poll intervals,
# timezone, ...) has a shared default in defaults.env / code, so you do NOT list
# tunables here. Docker reads this file AFTER defaults.env (see
# docker-compose.yml), so any key set here overrides the committed default.
#
# The file is intentionally NOT named `.env`: Docker Compose auto-loads `.env`
# for YAML interpolation, which mangles werkzeug password hashes (they contain
# `$`). Using a different name avoids that.

# ============================================================================
# Required — the app refuses to start without these (all secret / per-machine).
# ============================================================================
FLASK_SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
# Generate the hash with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
ADMIN_PASSWORD_HASH=

# Modbus-TCP relay module IP for each building.
RELAY_IP_BUILDING_1=192.168.2.200
RELAY_IP_BUILDING_3=192.168.2.200
RELAY_IP_BUILDING_5=192.168.2.200
# Comma-separated list of buildings actually wired up (others shown but disabled).
EQUIPPED_BUILDINGS=building_1

# ============================================================================
# Per-machine notification values (optional — omit to disable that piece).
# ============================================================================
# ntfy topic — pick an UNGUESSABLE name (on the public server the topic name is
# the only access control). Empty => push disabled, log only.
NTFY_TOPIC=
# Optional bearer token for a reserved / self-hosted topic.
NTFY_TOKEN=
# Public dashboard URL: the "tap to open" target on notifications, and shown on
# the subscribe page.
PUBLIC_BASE_URL=
# healthchecks.io ping URL for the app-down heartbeat. Empty => disabled.
HEALTHCHECK_URL=
