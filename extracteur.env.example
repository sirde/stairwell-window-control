FLASK_SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
# Generate with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
ADMIN_PASSWORD_HASH=

# Weather — Open-Meteo (free, no API key). Location of the residence.
WEATHER_LAT=46.3833
WEATHER_LON=6.2333
# How often to poll the forecast (seconds).
WEATHER_POLL_SECONDS=600
# Models tried in order; CH1/CH2 are MeteoSwiss (Alpine convection), then the
# default best-match blend as a fallback.
WEATHER_MODELS=meteoswiss_icon_ch1,meteoswiss_icon_ch2
# Imminent window for the "close now" check, and a longer high-risk-day watch.
WEATHER_LOOKAHEAD_HOURS=3
WEATHER_WATCH_HOURS=12
# Close advisory fires on high wind OR rain (either alone): gust >=
# WIND_GUST_THRESHOLD_KMH, or rain (radar within RADAR_RAIN_RADIUS_KM, or
# forecast precipitation / probability >= RAIN_PROB_THRESHOLD).
RAIN_PROB_THRESHOLD=60
WIND_GUST_THRESHOLD_KMH=40
# CAPE (convective fuel, J/kg) above this flags a "caution" high-risk day (info
# only, never auto-closes — convection is near-daily in a heatwave).
CAPE_THRESHOLD=1000

# Radar nowcast (RainViewer, free, no key; needs Pillow). Observe-only: detects
# rain on/near the residence that forecasts miss. Echo within the radius (km)
# counts as "rain near us".
RADAR_ENABLED=1
RADAR_RAIN_RADIUS_KM=10
RADAR_POLL_SECONDS=300
RADAR_ZOOM=8
# Timezone for displayed timestamps (storage stays UTC).
DISPLAY_TZ=Europe/Paris

# Modbus-TCP relay module IP for each building
RELAY_IP_BUILDING_1=192.168.2.200
RELAY_IP_BUILDING_3=192.168.2.200
RELAY_IP_BUILDING_5=192.168.2.200

# Comma-separated list of buildings that are actually wired up.
# Others are shown in the UI but disabled.
EQUIPPED_BUILDINGS=building_1
