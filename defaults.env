# defaults.env — committed, NON-SECRET deployment defaults.
#
# Layered UNDER extracteur.env in docker-compose.yml, so any value here can be
# overridden per-machine (or by the compose `environment:` block).
#
# >>> ADD NEW NON-SECRET SETTINGS HERE. <<<  They then propagate to every
# deployment via `git pull`, with no per-machine env editing. Secrets and
# per-machine values (passwords, relay IPs, ntfy topic, healthcheck URL) live in
# extracteur.env (gitignored) instead — see extracteur.env.example.
#
# Every key here also has a matching default in code, so a machine that never
# reads this file still runs; the file just keeps the fleet-wide defaults in one
# reviewable place.
#
# NOTE: the tunables listed in settings_env.py (drive durations, weather
# thresholds, night-airing grace, stale delays) can also be set from the UI
# settings page (/config), which saves them to SETTINGS_ENV_FILE — those
# UI-saved values take precedence over this file AND extracteur.env.

# Logging
LOG_LEVEL=INFO

# --- Window drive durations (seconds the motor is powered per command). ---
# Travel is timed (no position feedback). WINDOW_FULL_TRAVEL_SECONDS is fully
# shut -> fully open; close overdrives past it to seat shut (safe — stalls at the
# frame like the hand switch); partial is the "cracked" open used when breezy/wet.
# Close and partial are DERIVED from full travel (full+10 / full/2) so a retune
# of full travel follows through automatically — leave them unset here.
# Uncomment one only to pin it independently of full travel.
WINDOW_FULL_TRAVEL_SECONDS=20
#WINDOW_CLOSE_SECONDS=30
#WINDOW_PARTIAL_OPEN_SECONDS=10

# --- Weather (Open-Meteo). Location of the residence (Nyon). ---
WEATHER_LAT=46.3833
WEATHER_LON=6.2333
WEATHER_POLL_SECONDS=600
WEATHER_MODELS=meteoswiss_icon_ch1,meteoswiss_icon_ch2
WEATHER_LOOKAHEAD_HOURS=3
WEATHER_WATCH_HOURS=12
RAIN_PROB_THRESHOLD=60
WIND_GUST_THRESHOLD_KMH=40
# Fully open only below this gust (and dry); between here and the close threshold
# above = partial open. Lower companion to WIND_GUST_THRESHOLD_KMH.
WIND_FULL_OPEN_MAX_KMH=20
CAPE_THRESHOLD=1000
# Auto-open is gated to the night + this many hours past sunrise (south-facing
# roof barely heats early; coldest air is just after dawn).
MORNING_VENT_GRACE_HOURS=2
# Grace periods before a precautionary close when the forecast can't be fetched.
WEATHER_STALE_RISKY_SECONDS=600
WEATHER_STALE_CALM_SECONDS=5400

# --- Radar nowcast (RainViewer). ---
# Keep RADAR_ZOOM=7: the global mosaic only serves up to zoom 7; higher returns a
# "not supported" placeholder whose grey text is misread as rain. Do not raise.
RADAR_ENABLED=1
RADAR_ZOOM=7
RADAR_RAIN_RADIUS_KM=10
RADAR_POLL_SECONDS=300

# --- Notifications (ntfy). ---
# Enable flag + server are shared here; the TOPIC/TOKEN are secret and live in
# extracteur.env. With no topic set, push is disabled (log only).
NTFY_ENABLED=1
NTFY_SERVER=https://ntfy.sh
# Push on every open/close. On by default (residents want to know); set 0 to mute.
NOTIFY_MANUAL_ACTIONS=1
# App-down heartbeat interval (the ping URL itself is per-machine, in extracteur.env).
HEALTHCHECK_INTERVAL_SECONDS=300

# --- Relay reachability monitor. ---
# How often to TCP-probe each equipped building's relay board. A healthy->down
# transition raises one "module injoignable" push; recovery is logged only.
RELAY_PING_SECONDS=60

# Timezone for displayed timestamps (storage stays UTC).
DISPLAY_TZ=Europe/Paris
